{
  "name": "@ahengine/editor",
  "version": "0.1.0",
  "description": "Installable AHEngine 3D scene editor — a Vite plugin that serves the editor beside your product and saves scenes/prefabs/materials/animations into your project.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin/plugin.d.ts",
      "import": "./dist/plugin/plugin.js"
    }
  },
  "types": "./dist/plugin/plugin.d.ts",
  "keywords": [
    "3d",
    "editor",
    "webgpu",
    "three",
    "koota",
    "ecs",
    "vite-plugin",
    "react-three-fiber"
  ],
  "scripts": {
    "build": "vite build && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@ahengine/ecs-runtime": "workspace:*",
    "@ahengine/editor-core": "workspace:*",
    "@ahengine/editor-ui": "workspace:*",
    "@ahengine/project-schema": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tsup": "^8.5.0",
    "vite": "^8.2.2"
  }
}
