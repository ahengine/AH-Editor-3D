{
  "name": "@ahengine/project-schema",
  "version": "0.1.0",
  "description": "Zod schemas, types and migrations for the AHEngine (Koota + WebGPU) project format.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
